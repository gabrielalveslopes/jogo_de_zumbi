{
  "name": "zombie-apocalypse-last-stand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zombie Apocalypse: Last Stand - roguelite de sobrevivência 2D para navegador",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "vite",
